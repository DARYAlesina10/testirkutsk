generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum UserRole { USER ADMIN }
enum Tariff { FREE PREMIUM PRO }
enum WatchRuleType { PRICE_BELOW PERCENT_DROP }
enum NotificationType { PRICE_DROP SYSTEM BILLING }
enum NotificationChannel { WEB TELEGRAM EMAIL }
enum NotificationStatus { PENDING SENT FAILED READ }
enum ClickSource { WEB BOT ADMIN }
enum SearchRequestStatus { PENDING DONE FAILED }
enum SubscriptionStatus { ACTIVE CANCELED EXPIRED TRIAL }
enum AffiliateLinkStatus { CREATED FAILED }
enum PartnerArticleStatus { CREATED FAILED }
enum AffiliateOrderStatus { NEW PAID CANCELED SHIPPED COMPLETED }
enum SyncStatus { SUCCESS PARTIAL FAILED RATE_LIMITED }

model User {
  id            String         @id @default(cuid())
  email         String         @unique
  passwordHash  String
  role          UserRole       @default(USER)
  favorites     Favorite[]
  watchRules    WatchRule[]
  notifications Notification[]
  clicks        Click[]
  subscriptions Subscription[]
  searchRequests SearchRequest[]
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  @@index([createdAt])
}

model Category {
  id        String    @id @default(cuid())
  name      String
  slug      String    @unique
  products  Product[]
  createdAt DateTime  @default(now())

  @@index([createdAt])
}

model Product {
  id           String        @id @default(cuid())
  title        String
  slug         String        @unique
  categoryId   String
  currentPrice Decimal       @db.Decimal(12, 2)
  oldPrice     Decimal?      @db.Decimal(12, 2)
  imageUrl     String?
  marketUrl    String?
  partnerArticle String?
  category     Category      @relation(fields: [categoryId], references: [id])
  priceHistory PriceHistory[]
  favorites    Favorite[]
  watchRules   WatchRule[]
  clicks       Click[]
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt

  @@index([categoryId])
  @@index([createdAt])
}

model PriceHistory {
  id        String   @id @default(cuid())
  productId String
  price     Decimal  @db.Decimal(12, 2)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@index([productId])
  @@index([createdAt])
}

model Favorite {
  id        String   @id @default(cuid())
  userId    String
  productId String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  product   Product  @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([userId, productId])
  @@index([userId])
  @@index([productId])
}

model WatchRule {
  id          String         @id @default(cuid())
  userId       String
  productId    String
  type         WatchRuleType @default(PRICE_BELOW)
  targetPrice  Decimal?      @db.Decimal(12, 2)
  targetPercent Int?
  active       Boolean       @default(true)
  user         User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  product      Product       @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt    DateTime      @default(now())

  @@index([userId])
  @@index([productId])
  @@index([createdAt])
}

model Notification {
  id        String              @id @default(cuid())
  userId    String
  type      NotificationType
  channel   NotificationChannel @default(WEB)
  status    NotificationStatus  @default(PENDING)
  message   String
  meta      Json?
  user      User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}

model Click {
  id         String      @id @default(cuid())
  userId     String?
  productId  String
  source     ClickSource
  selectedUrl String
  vid        String?
  user       User?       @relation(fields: [userId], references: [id], onDelete: SetNull)
  product    Product     @relation(fields: [productId], references: [id], onDelete: Cascade)
  createdAt  DateTime    @default(now())

  @@index([userId])
  @@index([productId])
  @@index([vid])
  @@index([createdAt])
}

model AffiliateLink {
  id           String              @id @default(cuid())
  status       AffiliateLinkStatus @default(CREATED)
  originalUrl  String
  affiliateUrl String?
  shortUrl     String?
  selectedUrl  String?
  clid         String?
  vid          String?
  erid         String?
  searchType   String?
  pageName     String?
  productPhoto String?
  requestId    String?
  rawResponse  Json?
  createdAt    DateTime            @default(now())

  @@index([vid])
  @@index([status])
  @@index([createdAt])
}

model PartnerArticle {
  id                    String               @id @default(cuid())
  status                PartnerArticleStatus @default(CREATED)
  partnerArticle        String?
  originalMarketArticle String?
  resolvedMarketArticle String?
  clid                  String?
  vid                   String?
  preserveOfferArticle  Boolean              @default(false)
  requestId             String?
  rawResponse           Json?
  createdAt             DateTime             @default(now())

  @@index([vid])
  @@index([status])
  @@index([createdAt])
}

model AffiliateOrder {
  id            String               @id @default(cuid())
  orderId       String               @unique
  status        AffiliateOrderStatus @default(NEW)
  clid          String?
  vid           String?
  promocode     String?
  dateCreated   DateTime?
  dateUpdated   DateTime?
  additionalInfo Json?
  cart          Json?
  payment       Json?
  tariff        Json?
  items         AffiliateOrderItem[]
  createdAt     DateTime             @default(now())

  @@index([orderId])
  @@index([vid])
  @@index([status])
  @@index([createdAt])
  @@index([dateCreated])
  @@index([dateUpdated])
}

model AffiliateOrderItem {
  id               String         @id @default(cuid())
  affiliateOrderId String
  sku              String?
  name             String?
  quantity         Int?
  price            Decimal?       @db.Decimal(12, 2)
  order            AffiliateOrder @relation(fields: [affiliateOrderId], references: [id], onDelete: Cascade)

  @@index([affiliateOrderId])
}

model AffiliateOrderSyncLog {
  id         String     @id @default(cuid())
  status     SyncStatus
  error      String?
  startedAt  DateTime   @default(now())
  finishedAt DateTime?

  @@index([status])
  @@index([startedAt])
}

model AffiliateRateLimitState {
  id               String   @id @default(cuid())
  globalLimit      Int?
  globalRemaining  Int?
  globalUntil      DateTime?
  dailyLimit       Int?
  dailyRemaining   Int?
  dailyUntil       DateTime?
  methodLimit      Int?
  methodRemaining  Int?
  methodUntil      DateTime?
  blockedUntil     DateTime?
  lastError        String?
  updatedAt        DateTime @updatedAt

  @@index([updatedAt])
}

model AffiliateAccount {
  id         String   @id @default(cuid())
  clid       String?
  vid        String?
  apiKeySet  Boolean  @default(false)
  mockMode   Boolean  @default(true)
  createdAt  DateTime @default(now())

  @@index([vid])
}

model SubscriptionPlan {
  id           String         @id @default(cuid())
  tariff       Tariff         @unique
  name         String
  price        Decimal        @db.Decimal(12, 2)
  features     Json
  subscriptions Subscription[]
  createdAt    DateTime       @default(now())
}

model Subscription {
  id         String             @id @default(cuid())
  userId     String
  planId     String
  status     SubscriptionStatus @default(ACTIVE)
  user       User               @relation(fields: [userId], references: [id], onDelete: Cascade)
  plan       SubscriptionPlan   @relation(fields: [planId], references: [id], onDelete: Restrict)
  startedAt  DateTime           @default(now())
  endsAt     DateTime?

  @@index([userId])
  @@index([status])
}

model SearchRequest {
  id        String              @id @default(cuid())
  userId    String?
  query     String
  status    SearchRequestStatus @default(PENDING)
  result    Json?
  user      User?               @relation(fields: [userId], references: [id], onDelete: SetNull)
  createdAt DateTime            @default(now())

  @@index([userId])
  @@index([status])
  @@index([createdAt])
}
