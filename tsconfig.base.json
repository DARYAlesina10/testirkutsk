{
  "compilerOptions": {
    "target": "ES2022",
    "module": "CommonJS",
    "moduleResolution": "Node",
    "strict": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "resolveJsonModule": true,
    "forceConsistentCasingInFileNames": true,
    "baseUrl": ".",
    "paths": {
      "@cs/shared/*": ["packages/shared/src/*"],
      "@cs/config/*": ["packages/config/src/*"],
      "@cs/database/*": ["packages/database/src/*"]
    }
  }
}
